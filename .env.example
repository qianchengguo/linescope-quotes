# Example only. These variables are read from the process environment.
# .env is not loaded automatically by Python; Compose reads it automatically.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
LINESCOPE_DB=data/linescope.sqlite3
LINESCOPE_PORT=8765
# Compose-only host endpoint; independent of the native Python process URL.
OLLAMA_CONTAINER_BASE_URL=http://host.docker.internal:11434
